rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Firebase 콘솔 > Authentication > Users 에서 복사한 관리자 UID로 교체.
    // 관리자가 여럿이면 배열에 UID를 추가.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['0gmFOL8LaxgG0dmWxT0TSvhIxeR2'];
    }

    match /haggadot/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
             'reference', 'referenceEn',
             'bodyKo', 'bodyEn', 'publishedAt'])
        && request.resource.data.bodyKo is string
        && request.resource.data.bodyEn is string
        && request.resource.data.bodyKo.size() < 20000
        && request.resource.data.bodyEn.size() < 20000;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
